# ========================================
# FirmaVault SAT — Variables de Entorno (Ejemplo)
# ========================================
# Copia este archivo como .env y ajusta los valores

PORT=3001
# Local (SQLite):
DATABASE_URL="file:./dev.db"
# Producción (PostgreSQL):
# DATABASE_URL="postgresql://admin:adminpassword@localhost:5432/sat_db?schema=public"
JWT_SECRET="cambiar-en-produccion-usar-string-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"
MASTER_PASSWORD="cambiar-en-produccion"
ADMIN_PASSWORD="cambiar-en-produccion"
ENCRYPTION_KEY="generar-con-node-e-console.log(require('crypto').randomBytes(32).toString('hex'))"
CORS_ORIGINS="http://localhost:5173,http://localhost:3001,https://midominio.com"
NODE_ENV="development"

# La base de datos persistirá en la carpeta 'data' usando SQLite en producción
# No usar variables de Postgres.
